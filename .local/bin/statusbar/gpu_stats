#!/bin/bash
set -euo pipefail

format_usage() {
    local val=$1
    val=${val%.*} # Strip decimals
    
    # Check if integer
    if ! [[ "$val" =~ ^[0-9]+$ ]]; then
        echo "??%"
        return
    fi

    if [[ "$val" -lt 10 ]]; then
        val="0$val"
    elif [[ "$val" -ge 100 ]]; then
        val="99"
    fi
    echo "${val}%"
}

get_amd_stats() {
    local temp=""
    local usage=""

    # Temp: Try junction, then edge, then generic
    temp=$(sensors | rg -A10 amdgpu-pci-0900 | rg junction | awk '{print $2}' | awk -F'.' '{print $1}' | sed 's/+//')

    # Usage: Try amdgpu_top -> sysfs
    if command -v amdgpu_top &> /dev/null && command -v jq &> /dev/null; then
        usage=$(amdgpu_top --json -n 1 | jq -r '.devices[0].gpu_activity.GFX.value' 2>/dev/null)
    fi
    
    if [[ -z "$usage" || "$usage" == "null" ]]; then
        # Check standard sysfs paths for card0 or card1
        for card in /sys/class/drm/card*; do
            if [[ -f "$card/device/gpu_busy_percent" ]]; then
                usage=$(cat "$card/device/gpu_busy_percent")
                break
            fi
        done
    fi

    echo "${temp:-??} $(format_usage "${usage:-0}")"
}

find_pci_gpu() {
    # Prints the sysfs path of the first display controller with the given PCI vendor id
    local vendor=$1 dev
    for dev in /sys/bus/pci/devices/*; do
        [[ "$(cat "$dev/class")" == 0x03* && "$(cat "$dev/vendor")" == "$vendor" ]] && { echo "$dev"; return; }
    done
}

get_nvidia_stats() {
    local dev=$1
    local temp=""
    local usage=""

    # Never wake the dGPU just to read it: nvidia-smi powers it up, and polling every few
    # seconds keeps it from ever suspending (extra heat and battery drain on a hybrid laptop).
    if [[ "$(cat "$dev/power/runtime_status" 2>/dev/null)" != "active" ]]; then
        echo "off"
        return
    fi
    # Awake but no program holds the device open -> it will suspend on its own, leave it alone
    if [[ -z "$(find /proc/[0-9]*/fd -lname '/dev/nvidia[0-9]*' -print -quit 2>/dev/null)" ]]; then
        echo "idle"
        return
    fi

    local output=$(nvidia-smi --query-gpu=temperature.gpu,utilization.gpu --format=csv,noheader,nounits)
    temp=$(echo "$output" | cut -d ',' -f1 | tr -d ' ')
    usage=$(echo "$output" | cut -d ',' -f2 | tr -d ' ')

    echo "${temp:-??}°C $(format_usage "${usage:-0}")"
}

get_intel_stats() {
    local dev=$1
    local temp=""
    local usage=""

    # 1. Get Temperature
    # The iGPU sits on the CPU die, so the package temperature is the best available reading.
    temp=$(sensors 2> /dev/null | awk '/Package id 0/ {print $4}' | tr -d '+°C' | cut -d. -f1 | head -n1)

    # 2. Get Usage without root (intel_gpu_top needs CAP_PERFMON):
    # busy = 1 - (time spent in the RC6 sleep state / wall time) since the previous run
    local drm rc6="" state="${XDG_RUNTIME_DIR:-/tmp}/gpu_stats.intel"
    for drm in "$dev"/drm/card*; do
        [[ -f "$drm/gt/gt0/rc6_residency_ms" ]] && rc6=$(cat "$drm/gt/gt0/rc6_residency_ms") && break
        [[ -f "$drm/power/rc6_residency_ms" ]] && rc6=$(cat "$drm/power/rc6_residency_ms") && break
    done
    if [[ -n "$rc6" ]]; then
        local now=$(( $(date +%s%N) / 1000000 )) prev_rc6 prev_now
        if read -r prev_rc6 prev_now 2>/dev/null < "$state" && (( now > prev_now )); then
            usage=$(( 100 - 100 * (rc6 - prev_rc6) / (now - prev_now) ))
            (( usage < 0 )) && usage=0
        fi
        echo "$rc6 $now" > "$state"
    fi

    echo "${temp:-??}°C $(format_usage "${usage:-0}")"
}

# --- Main Logic ---

# 1. AMD desktop: single GPU
if lsmod | grep -q "^amdgpu"; then
    read temp usage <<< "$(get_amd_stats)"
    echo " ${temp}°C $usage"
    exit 0
fi

# 2. Intel iGPU and/or NVIDIA dGPU (hybrid laptop): show every GPU that exists
intel_dev=$(find_pci_gpu 0x8086)
nvidia_dev=$(find_pci_gpu 0x10de)
out=""
[[ -n "$intel_dev" ]] && out+="i $(get_intel_stats "$intel_dev")"
if [[ -n "$nvidia_dev" ]] && command -v nvidia-smi &> /dev/null; then
    out+="${out:+  }n $(get_nvidia_stats "$nvidia_dev")"
fi

echo " ${out:-??}"
