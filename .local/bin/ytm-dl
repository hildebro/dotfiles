#!/bin/bash

# Download audio via yt-dlp (YouTube, Bandcamp, ...), embed metadata and move it to a web server.

set -e

# --- Configuration ---
SSH_TARGET="webserver"
REMOTE_MUSIC_DIR="/srv/files/Music"

# --- Main Script ---
if [ -z "$1" ]; then
    echo "Usage: $0 <youtube_or_bandcamp_url>"
    exit 1
fi
URL="$1"

# --- Site-specific yt-dlp arguments ---
if [[ "$URL" =~ bandcamp\.com ]]; then
    SITE="Bandcamp"
    # Source is already MP3: keep it as-is (no re-encode), embed cover art,
    # and use Bandcamp's real track numbers.
    YTDLP_ARGS=(-x --audio-format mp3 --embed-metadata --embed-thumbnail)
    OUT_TEMPLATE="%(track_number|)02d %(artist,uploader).30s - %(title)s.%(ext)s"
else
    SITE="YouTube/other"
    YTDLP_ARGS=(-x --audio-format mp3 --audio-quality 0 --embed-metadata)
    OUT_TEMPLATE="%(playlist_index|)s %(artist,uploader).30s - %(title)s.%(ext)s"
fi

download() {
    yt-dlp "${YTDLP_ARGS[@]}" --trim-filenames 200 -o "$OUT_TEMPLATE" "$URL"
}

count_mp3() {
    find . -maxdepth 1 -name "*.mp3" | wc -l
}

echo "--- Starting download and transfer process ($SITE) ---"

echo "1. Creating and moving to temporary directory..."
TEMP_DIR=$(mktemp -d /tmp/ytdlp-music.XXXXXX)
cd "$TEMP_DIR"
trap 'rm -rf "$TEMP_DIR"' ERR INT TERM

echo "2. Getting expected track count..."
EXPECTED_COUNT=$(yt-dlp --quiet --no-warnings --flat-playlist --print id "$URL" | wc -l)

if ! [[ "$EXPECTED_COUNT" =~ ^[0-9]+$ ]] || [ "$EXPECTED_COUNT" -eq 0 ]; then
    echo "Error: Could not determine a valid track count from the URL. Exiting."
    rm -rf "$TEMP_DIR"
    exit 1
fi
echo "    - Expected song count: $EXPECTED_COUNT"

echo "3. Downloading songs..."
# Don't let a single failed track abort the script; the retry loop handles it.
download || true
DOWNLOADED_COUNT=$(count_mp3)

while [ "$DOWNLOADED_COUNT" -lt "$EXPECTED_COUNT" ]; do
    echo "Warning: Download was incomplete ($DOWNLOADED_COUNT/$EXPECTED_COUNT downloaded)."
    read -p "Would you like to retry the missing downloads? (Y/n): " RETRY_ANS
    RETRY_ANS=${RETRY_ANS:-Y}

    case "$RETRY_ANS" in
        [nN]*)
            echo "Skipping retries. Proceeding with $DOWNLOADED_COUNT songs..."
            break
            ;;
        *)
            echo "Retrying missing songs..."
            download || true
            DOWNLOADED_COUNT=$(count_mp3)
            ;;
    esac
done

echo "    - Successfully downloaded $DOWNLOADED_COUNT song(s)."

echo "4. Extracting and verifying metadata..."
MP3_FILE=$(find . -maxdepth 1 -name "*.mp3" -print -quit)

if [ -z "$MP3_FILE" ]; then
    echo "Error: No mp3 files found to process. Exiting."
    rm -rf "$TEMP_DIR"
    exit 1
fi

ARTIST=$(ffprobe -v quiet -show_entries format_tags=artist -of default=nw=1:nk=1 "$MP3_FILE")
ALBUM=$(ffprobe -v quiet -show_entries format_tags=album -of default=nw=1:nk=1 "$MP3_FILE")

if [ -z "$ARTIST" ]; then
    ARTIST=$(yt-dlp --print "%(artist,uploader|Unknown Artist)s" --no-download "$URL" | head -n 1)
fi
if [ -z "$ALBUM" ]; then
    ALBUM=$(yt-dlp --print "%(album,playlist|Unknown Album)s" --no-download "$URL" | head -n 1)
fi

# --- Interactive Album Artist Prompt ---
echo ""
echo "Album: $ALBUM"
echo "Please confirm or adjust the detected album artist:"
read -e -i "$ARTIST" -p "> " ALBUM_ARTIST
echo ""

echo "5. Writing Album Artist tags to files..."
for file in *.mp3; do
    id3v2 --TPE2 "$ALBUM_ARTIST" "$file"
done

echo "6. Checking for remote directory and creating if it doesn't exist..."
REMOTE_DIR="${REMOTE_MUSIC_DIR}/${ALBUM_ARTIST//\//-}/${ALBUM//\//-}"
REMOTE_DIR_Q=$(printf '%q' "$REMOTE_DIR")
ssh "$SSH_TARGET" "mkdir -p $REMOTE_DIR_Q"

echo "7. Transferring files to $SSH_TARGET:$REMOTE_DIR..."
scp ./*.mp3 "$SSH_TARGET:$REMOTE_DIR/"

echo "8. Cleaning up local temporary files..."
cd /tmp
rm -rf "$TEMP_DIR"

echo "9. Importing into Beets on remote server..."
ssh -t "$SSH_TARGET" "cd $REMOTE_DIR_Q && beet import ./"

echo "--- Process complete! ---"
